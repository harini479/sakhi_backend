# ============================================================================
# Sakhi Backend — Runtime Environment Configuration (Public Demo Mode)
# ============================================================================
APP_ENV=production
LOG_LEVEL=INFO
PORT=8080
DEMO_MODE=true

# Cloud Run Project Details
GOOGLE_CLOUD_PROJECT=sakhi-buildathon
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)

# Security & Auth (Firebase/Supabase disabled for MVP public buildathon demo)
REQUIRE_FIREBASE_AUTH=false
WEBHOOK_SECRET=

# Allowed frontend origin (no trailing slash, no wildcards)
CORS_ORIGINS=https://frontend-service-727289315493.asia-south1.run.app

# Google Gemini Developer API (Set via Cloud Run secrets / env vars)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=6.0

# Optional: Secondary OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: External Knowledge Base / Places (Not required for synthetic demo)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
GOOGLE_PLACES_API_KEY=
HOSPITAL_SEARCH_RADIUS_METERS=10000
