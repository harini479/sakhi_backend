# Runtime Environment ("development" locally, "production" on Cloud Run)
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080

# Google Cloud & Firebase (Cloud Run uses Application Default Credentials — no JSON key file needed)
GOOGLE_CLOUD_PROJECT=
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)

# Security & Auth (automatically enabled when APP_ENV=production)
REQUIRE_FIREBASE_AUTH=false
WEBHOOK_SECRET=

# Comma-separated allowed frontend origins (no trailing slash, no wildcard in production)
# Example: http://localhost:5173,https://sakhi-frontend-xxxx.asia-south1.run.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini Developer API (store GEMINI_API_KEY in Google Secret Manager for Cloud Run)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=6.0

# Optional: Secondary OpenAI fallback (leave blank if using Gemini only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: External Supabase Knowledge Base (HTTPS URL only; store key in Secret Manager)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Optional: Google Places API for live nearby hospital search (store key in Secret Manager)
GOOGLE_PLACES_API_KEY=
HOSPITAL_SEARCH_RADIUS_METERS=10000
